# Connection string for the Postgres database (Neon). Format:
# postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Secret used by NextAuth.js (Auth.js) to sign session tokens. Generate one with:
# openssl rand -base64 32
NEXTAUTH_SECRET=

# Same value as NEXTAUTH_SECRET — Auth.js v5 reads AUTH_SECRET; kept for compatibility.
AUTH_SECRET=

# Public URL of the deployed app (e.g. https://inp.usiquimica.com.br or the Vercel URL).
NEXTAUTH_URL=

# API key from Resend (resend.com) used to send transactional emails.
# Can be left unset at first: the app works fully, it just logs (does not send) emails until this is set.
RESEND_API_KEY=

# The "from" address used when sending emails, e.g. "INP Usiquimica <inp@usiquimica.com.br>"
# Must be on a domain verified in Resend.
EMAIL_FROM=

# Shared secret required (as "Authorization: Bearer <value>") to call the daily notifications cron route.
# Generate one with: openssl rand -base64 32
CRON_SECRET=

# Read/write token for Vercel Blob storage (file attachments). Created automatically when you
# add the Blob store to your Vercel project, or manually in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=
